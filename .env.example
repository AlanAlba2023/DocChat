# ============================================
# DEEPSEEK API (LLM principal - RECOMENDADO)
# ============================================
# Obtén tu API Key en: https://platform.deepseek.com/
DEEPSEEK_API_KEY="sk-coloca-tu-api-key-aqui"
DEEPSEEK_API_BASE="https://api.deepseek.com/v1"
DEEPSEEK_MODEL="deepseek-chat"  # o "deepseek-reasoner" para razonamiento avanzado

# ============================================
# HUGGING FACE (opcional - solo para respaldo)
# ============================================
# Si quieres usar Hugging Face como LLM alternativo (gratuito con límites)
# Obtén tu token en: https://huggingface.co/settings/tokens
HUGGINGFACEHUB_API_TOKEN="hf_coloca-tu-token-aqui"  # Opcional

# ============================================
# CONFIGURACIÓN DEL SISTEMA
# ============================================
# Directorio donde ChromaDB guardará los vectores (persistente)
CHROMA_PERSIST_DIR="./chroma_db"

# Modelo de embeddings de Hugging Face (gratuito, local)
EMBEDDINGS_MODEL="sentence-transformers/all-MiniLM-L6-v2"

# Tamaño máximo de archivo PDF (en MB)
MAX_FILE_SIZE_MB=100

# Directorio para archivos temporales (se crea automáticamente)
TEMP_UPLOAD_DIR="./temp_uploads"
